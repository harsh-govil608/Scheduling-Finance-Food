<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Permission footprint matches exactly what's implemented
        (docs/mvp-pilot/01-system-design-and-architecture.md, Section 9). POST_NOTIFICATIONS
        added Day 2 alongside the Notification Center + bill/subscription/budget alerts - see
        docs/coders-documentation/day-2.md. REQUEST_INSTALL_PACKAGES added Day 3 for the in-app
        updater (UpdateChecker.kt) so pilot testers stop needing a manually re-sent APK file for
        every fix.
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Family module SOS workflow (2026-08): fine location for the SOS alert's captured
         coordinates, coarse as the fallback Android requires you to also declare. Requested only
         when the user actually taps SOS or opts into presence location sharing - never at app
         launch, matching this app's existing "ask at the point of use" pattern (see
         PermissionScreen). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Family invites / Smart Split participants (2026-08): "pick from contacts" instead of
         hand-typing a phone number. Requested only when that button is actually tapped - see
         ContactPicker.kt. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Smart Split's UPI payment intent (2026-08, real user report: "not able to pay the amount
         using GPay"). Since Android 11 (API 30), an app can't see/resolve another installed app
         for an implicit intent at all unless it's declared here - without this, UpiPay.payIntent's
         upi://pay Intent silently fails to find GPay/PhonePe/any UPI app, target SDK 30+ or not,
         no error shown, exactly this symptom. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.ExpenseCapture">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ExpenseCapture">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Voice quick-capture (2026-08, real user request: "AI voice assistant outside app
             for quick records and summaries") - see VoiceCaptureActivity's kdoc. exported=false:
             only this app's own VoiceCaptureTileService ever launches it. -->
        <activity
            android:name=".voice.VoiceCaptureActivity"
            android:exported="false"
            android:theme="@style/Theme.VoiceCapture"
            android:excludeFromRecents="true" />

        <!-- android:permission is required for a TileService - without it the system refuses to
             bind it (any app could otherwise inject a fake tile). exported=true is likewise
             required so the system's Quick Settings host (a different process) can bind it. -->
        <service
            android:name=".widget.VoiceCaptureTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Log by voice"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Widgets PRD (Phase 3 Doc 04): single home-screen "spent this month" widget.
             Bug fix (found via a real user report, 2026-08 - "widget nhi dikh raha", i.e. it
             never showed up in the home screen's Add Widget picker at all): exported must be
             true here, not false. A widget provider's receiver is bound to by the launcher app -
             a different process entirely - so an unexported receiver is invisible to it; this
             isn't the same "don't export things unnecessarily" rule that applies to most other
             components, it's a hard requirement for AppWidgetProvider specifically. -->
        <receiver
            android:name=".widget.SpendWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_spend_info" />
        </receiver>

        <!--
            Data Export & Portability PRD (Phase 3 Doc 47): required so the CSV export file
            (app-private cache storage) can be shared to other apps (Files, email, Drive, etc.)
            via the share sheet without violating scoped-storage rules.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
